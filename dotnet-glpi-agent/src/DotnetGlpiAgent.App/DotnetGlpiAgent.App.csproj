<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetGlpiAgent.Core\DotnetGlpiAgent.Core.csproj" />
    <ProjectReference Include="..\DotnetGlpiAgent.Windows\DotnetGlpiAgent.Windows.csproj" />
    <ProjectReference Include="..\DotnetGlpiAgent.Protocol\DotnetGlpiAgent.Protocol.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <AssemblyName>dotnet-glpi-agent</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Ship one self-contained exe: the MSI and the portable zip carry a
         single binary with agent.cfg next to it. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
